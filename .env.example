# Copy to .env only for the PRODUCTION build. Use the study's existing settings.
# Nothing here is needed for the prebuilt local preview.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=uva-webmunk
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
JITSU_WRITE_KEY=
JITSU_INGEST_URL=
STUDY_ID=uva_webmunk_rufus_v1
REMOTE_CONFIG_FETCH_INTERVAL=3600000
USER_FETCH_INTERVAL=3600000
DEBUG_LOGGING=false
# Optional PUBLIC extension key from the Store dashboard, to retain the existing
# extension ID during local production testing. Never paste a private signing key.
EXTENSION_PUBLIC_KEY=
